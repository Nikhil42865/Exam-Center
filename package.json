{
  "name": "examcenter",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared/contracts",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=shared/contracts && npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "seed": "npm run seed:admin && npm run seed:demo",
    "seed:admin": "npm run seed:admin --workspace=server",
    "seed:demo": "npx tsx src/seedDemoData.ts --workspace=server"
  },
  "keywords": [
    "exam",
    "assessment",
    "quiz",
    "mcq",
    "testing-platform"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
