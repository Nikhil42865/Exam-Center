NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/examcenter
CLIENT_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=super-secret-examcenter-access-key-minimum-32-chars-length
