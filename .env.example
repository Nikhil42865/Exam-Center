REFRESH_TOKEN_TTL=7d
LOG_LEVEL=info
ADMIN_INITIAL_EMAIL=admin@examcenter.internal
ADMIN_INITIAL_PASSWORD=AdminPassword123!
ADMIN_INITIAL_NAME=System Administrator
